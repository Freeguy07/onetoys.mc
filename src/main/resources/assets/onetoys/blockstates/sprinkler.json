{
	"multipart": [
		{
			"when": { "hanging": "false" },
			"apply": { "model": "onetoys:block/sprinkler_base" }
		},
		{
			"when": { "hanging": "true" },
			"apply": { "model": "onetoys:block/sprinkler_base", "x": 180 }
		},
		{
			"when": { "hanging": "false", "wave": "0" },
			"apply": { "model": "onetoys:block/sprinkler_rotor" }
		},
		{
			"when": { "hanging": "false", "wave": "1" },
			"apply": { "model": "onetoys:block/sprinkler_rotor_active" }
		},
		{
			"when": { "hanging": "false", "wave": "2" },
			"apply": { "model": "onetoys:block/sprinkler_rotor", "y": 90 }
		},
		{
			"when": { "hanging": "false", "wave": "3" },
			"apply": { "model": "onetoys:block/sprinkler_rotor_active", "y": 90 }
		},
		{
			"when": { "hanging": "false", "wave": "4" },
			"apply": { "model": "onetoys:block/sprinkler_rotor", "y": 180 }
		},
		{
			"when": { "hanging": "true", "wave": "0" },
			"apply": { "model": "onetoys:block/sprinkler_rotor", "x": 180 }
		},
		{
			"when": { "hanging": "true", "wave": "1" },
			"apply": { "model": "onetoys:block/sprinkler_rotor_active", "x": 180 }
		},
		{
			"when": { "hanging": "true", "wave": "2" },
			"apply": { "model": "onetoys:block/sprinkler_rotor", "x": 180, "y": 90 }
		},
		{
			"when": { "hanging": "true", "wave": "3" },
			"apply": { "model": "onetoys:block/sprinkler_rotor_active", "x": 180, "y": 90 }
		},
		{
			"when": { "hanging": "true", "wave": "4" },
			"apply": { "model": "onetoys:block/sprinkler_rotor", "x": 180, "y": 180 }
		}
	]
}
